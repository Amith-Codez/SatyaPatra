<mxfile host="app.diagrams.net"><diagram id="satyapatra-flow" name="SatyaPatra flow"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" page="1" pageWidth="1400" pageHeight="850" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;START&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8BC48A;strokeColor=#2E7D32;strokeWidth=2;fontColor=#10381A;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="668" y="2" width="64" height="64" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:17px"&gt;Role-based sign-in&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;JWT roles · government SSO&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFD966;strokeColor=#BF9000;strokeWidth=2;fontColor=#3D2E00;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="86" width="240" height="60" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;image=data:image/svg+xml,;aspect=fixed;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="593" y="104.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#3A3A3A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="shape=image;image=data:image/svg+xml,;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="26" height="26" as="geometry"/></mxCell><mxCell id="c7" value="Institution sign-in" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0B2A4A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="150" height="26" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;image=data:image/svg+xml,;aspect=f